<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Authentication/session material and the installation identity must not be restored after uninstall. -->
        <exclude domain="sharedpref" path="sitebin_supabase_session.xml" />
        <exclude domain="sharedpref" path="sitebin_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sitebin_supabase_session.xml" />
        <exclude domain="sharedpref" path="sitebin_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
