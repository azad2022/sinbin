<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Authentication/session material is tied to the device Keystore and must not be restored to another device. -->
        <exclude domain="sharedpref" path="sitebin_supabase_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sitebin_supabase_session.xml" />
    </device-transfer>
</data-extraction-rules>
